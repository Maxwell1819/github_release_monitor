# ============================================================
# GitHub Release Monitor 环境变量模板
# 使用：cp .env.example .env 后填入真实值；chmod 600 .env
# config.json 中通过 ${变量名} 引用（如 "token": "${GITHUB_TOKEN}"）
# ============================================================

# GitHub Personal Access Token（推荐配置，提升 API 限额 60 → 5000 次/小时）
# 申请：https://github.com/settings/tokens  （权限勾选 public_repo 即可）
GITHUB_TOKEN=ghp_xxx

# ---- 通知通道（按需填写；config.json 的 notify.channels 用哪个就填哪个）----

# PushPlus 推送（必填 token；群组推送时填 topic，单人推送可留空）
# 申请：http://www.pushplus.plus
PUSHPLUS_TOKEN=xxx
PUSHPLUS_TOPIC=

# Server酱推送（使用 serverchan 通道时必填）
# 申请：https://sct.ftqq.com
SERVERCHAN_KEY=

# Telegram Bot（使用 telegram 通道时必填 bot_token 与 chat_id）
# 创建 Bot 获取 token：与 @BotFather 对话；chat_id 可用 @userinfobot 查询
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 百度翻译（可选：不配置则禁用非中文 release notes 翻译）----
# 申请：https://api.fanyi.baidu.com （标准版免费）
BAIDU_APP_ID=
BAIDU_SECRET_KEY=

# ---- 网络代理（可选：无法直连 GitHub 时填写代理地址）----
# HTTPS_PROXY=http://192.168.1.1:7890
# HTTP_PROXY=http://192.168.1.1:7890


